\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture relationship diagram. (A) Sequential compression in RNN/LSTM: input history is compressed into fixed-size state $h_T$, creating an information bottleneck. (B) Lossless covariance in Transformer: attention matrix preserves all pairwise relationships explicitly. (C) Biological mechanism integration: transformers benefit most because mechanisms operate directly on relational structure rather than compressed representations.}}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch-compare}{{1}{7}{Architecture relationship diagram. (A) Sequential compression in RNN/LSTM: input history is compressed into fixed-size state $h_T$, creating an information bottleneck. (B) Lossless covariance in Transformer: attention matrix preserves all pairwise relationships explicitly. (C) Biological mechanism integration: transformers benefit most because mechanisms operate directly on relational structure rather than compressed representations}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Information-Theoretic Analysis}{7}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training convergence on the copy task. Solid lines show bio-enhanced variants; dashed lines show baselines. Shaded regions indicate 95\% confidence intervals across 3 seeds. Bio-enhanced transformers show the largest improvement in both convergence speed and final loss.}}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:convergence}{{2}{8}{Training convergence on the copy task. Solid lines show bio-enhanced variants; dashed lines show baselines. Shaded regions indicate 95\% confidence intervals across 3 seeds. Bio-enhanced transformers show the largest improvement in both convergence speed and final loss}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Copy task performance (mean $\pm $ std over 3 seeds). Bio-enhanced variants improve all architectures, with transformers showing the largest gains.}}{8}{table.caption.3}\protected@file@percent }
